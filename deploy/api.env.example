# /etc/missing-works/api.env  (owner root, group missingworks, mode 0640)
# Contains no secrets, but keep it out of the public site.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/missing-works/votes.sqlite
CATALOG_PATH=/opt/missing-works/data/catalog.json
# Exact origins only, comma separated. No wildcard. The GitHub Pages origin has no path.
ALLOWED_ORIGINS=https://lost-compositions.exe.xyz,https://akrentsel.github.io
# true only when the direct peer is a local reverse proxy (nginx/Caddy on loopback)
# that forwards an X-Forwarded-For whose LAST entry is the real client address.
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=600
# Never set SERVE_STATIC in production; GitHub Pages serves the site.
