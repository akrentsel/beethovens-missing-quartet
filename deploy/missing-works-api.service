[Unit]
Description=Missing Works voting API (Node + SQLite)
Documentation=file:///opt/missing-works/deploy/README.md
After=network.target

[Service]
Type=simple
User=missingworks
Group=missingworks
WorkingDirectory=/opt/missing-works
EnvironmentFile=/etc/missing-works/api.env
# Adjust if `command -v node` differs (must be Node 24+).
ExecStart=/usr/local/bin/node /opt/missing-works/server/index.mjs
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

# The only writable location: /var/lib/missing-works (database + WAL files).
StateDirectory=missing-works
StateDirectoryMode=0700
ReadWritePaths=/var/lib/missing-works
UMask=0077

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# V8's JIT needs writable+executable memory, so MemoryDenyWriteExecute stays off.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=
# The API only talks to the local reverse proxy.
IPAddressAllow=localhost
IPAddressDeny=any
LimitNOFILE=4096
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
