%%label I. Largo – Allegro
%%note F major. A short stately introduction and a ritornello Allegro with episodes for the oboes, the strings and the horns.
X:1
T:Handel’s Missing Symphony
T:I. Largo – Allegro
C:Claude (AI), in the manner of G. F. Handel
M:4/4
L:1/8
Q:"Largo" 1/4=54
%%score [hn1 hn2] [ob1 ob2 bn] [v1 v2 va vc cb] hpd
% Original AI-composed homage. The score is written at sounding pitch.
V:hn1 clef=treble name="Hn. I"
V:hn2 clef=treble name="Hn. II"
V:ob1 clef=treble name="Ob. I"
V:ob2 clef=treble name="Ob. II"
V:bn clef=bass name="Bn."
V:v1 clef=treble name="Vl. I"
V:v2 clef=treble name="Vl. II"
V:va clef=alto name="Vla."
V:vc clef=bass name="Vc."
V:cb clef=bass name="Cb."
V:hpd clef=treble name="Hpd."
K:F
V:hn1
