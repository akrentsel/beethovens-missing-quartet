%%label I. Adagio – Allegro
%%note B flat major. A slow introduction that darkens to the minor, and a sonata-form Allegro built almost entirely from one theme.
X:1
T:Haydn’s Missing Symphony
T:I. Adagio – Allegro
C:Claude (AI), in the manner of Joseph Haydn
M:3/4
L:1/8
Q:"Adagio" 1/4=56
%%score [fl ob bn] [hn tpt] timp [v1 v2 va vc cb]
% Original AI-composed homage. The score is written at sounding pitch.
V:fl clef=treble name="Fl."
V:ob clef=treble name="Ob. I, II"
V:bn clef=bass name="Bn. I, II"
V:hn clef=treble name="Hn. I, II"
V:tpt clef=treble name="Tpt. I, II"
V:timp clef=bass name="Timp."
V:v1 clef=treble name="Vl. I"
V:v2 clef=treble name="Vl. II"
V:va clef=alto name="Vla."
V:vc clef=bass name="Vc."
V:cb clef=bass name="Cb."
K:Bb
V:fl
