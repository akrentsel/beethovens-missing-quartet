%%label II. Largo
%%note E flat major. The solo violin sings over plucked strings.
X:1
T:Vivaldi’s Missing Symphony
T:II. Largo
C:Claude (AI), in the manner of A. Vivaldi
M:3/4
L:1/8
Q:"Largo" 1/4=50
%%score vs [v1 v2 va vc cb] hpd
% Original AI-composed homage. The score is written at sounding pitch.
V:vs clef=treble name="Vl. solo"
V:v1 clef=treble name="Vl. I pizz."
V:v2 clef=treble name="Vl. II pizz."
V:va clef=alto name="Vla. pizz."
V:vc clef=bass name="Vc. pizz."
V:cb clef=bass name="Cb. pizz."
V:hpd clef=treble name="Hpd."
K:Eb
V:vs
%%MIDI program 40
V:v1
%%MIDI program 45
V:v2
%%MIDI program 45
V:va
%%MIDI program 45
V:vc
%%MIDI program 45
V:cb
%%MIDI program 45
V:hpd
