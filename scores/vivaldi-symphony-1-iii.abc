%%label III. Presto
%%note G minor, 3/8. A driving dance in two repeated halves, built on one eight-bar theme and its sequences.
X:1
T:Vivaldi’s Missing Symphony
T:III. Presto
C:Claude (AI), in the manner of A. Vivaldi
M:3/8
L:1/8
Q:"Presto" 3/8=80
%%score vs [v1 v2 va vc cb] hpd
% Original AI-composed homage. The score is written at sounding pitch.
V:vs clef=treble name="Vl. solo"
V:v1 clef=treble name="Vl. I"
V:v2 clef=treble name="Vl. II"
V:va clef=alto name="Vla."
V:vc clef=bass name="Vc."
V:cb clef=bass name="Cb."
V:hpd clef=treble name="Hpd."
K:Gm
V:vs
%%MIDI program 40
V:v1
%%MIDI program 48
V:v2
%%MIDI program 48
V:va
%%MIDI program 48
V:vc
%%MIDI program 48
V:cb
%%MIDI program 43
V:hpd
