%%label I. Allegro
%%note B flat. A syncopated theme with blue notes over Charleston-rhythm chords, and a broad tune in E flat.
X:1
T:Gershwin’s Missing Symphony
T:I. Allegro
C:Claude (AI), in the manner of George Gershwin
M:4/4
L:1/8
Q:"Allegro" 1/4=126
%%score [fl ob cl sax bn] [hn tpt tbn] timp pno [v1 v2 va vc cb]
% Original AI-composed homage. The score is written at sounding pitch.
V:fl clef=treble name="Fl. I, II"
V:ob clef=treble name="Ob. I, II"
V:cl clef=treble name="Cl. I, II"
V:sax clef=treble name="A. Sax."
V:bn clef=bass name="Bn. I, II"
V:hn clef=treble name="Hn. I–IV"
V:tpt clef=treble name="Tpt. I–III"
V:tbn clef=bass name="Tbn. I–III, Tuba"
V:timp clef=bass name="Timp."
V:pno clef=treble name="Piano"
V:v1 clef=treble name="Vl. I"
V:v2 clef=treble name="Vl. II"
V:va clef=alto name="Vla."
V:vc clef=bass name="Vc."
V:cb clef=bass name="Cb."
K:Bb
V:fl
