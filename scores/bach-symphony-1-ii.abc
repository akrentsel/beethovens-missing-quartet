%%label II. Siciliano: Andante
%%note B minor. A lilting song for solo oboe over strings and harpsichord, in two repeated halves.
X:1
T:Bach’s Missing Symphony
T:II. Siciliano: Andante
C:Claude (AI), in the manner of J. S. Bach
M:6/8
L:1/8
Q:"Andante" 3/8=44
%%score ob1 [v1 v2 va vc cb] hpd
% Original AI-composed homage. The score is written at sounding pitch.
V:ob1 clef=treble name="Ob. solo"
V:v1 clef=treble name="Vl. I"
V:v2 clef=treble name="Vl. II"
V:va clef=alto name="Vla."
V:vc clef=bass name="Vc."
V:cb clef=bass name="Cb."
V:hpd clef=treble name="Hpd."
K:Bm
V:ob1
%%MIDI program 68
V:v1
%%MIDI program 48
V:v2
%%MIDI program 48
V:va
%%MIDI program 48
V:vc
%%MIDI program 48
V:cb
%%MIDI program 43
V:hpd
